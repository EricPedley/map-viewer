{
  "name": "erics-cycling-app",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "predev": "npm run convert-routes",
    "dev": "vite",
    "prebuild": "npm run convert-routes",
    "build": "vite build",
    "preview": "vite preview",
    "convert-routes": "node scripts/clean-routes.mjs && node scripts/convert-fit.mjs && node scripts/build-route-index.mjs",
    "convert-gpx": "node scripts/convert-gpx.mjs",
    "fetch-osm": "npm run convert-routes && node scripts/fetch-osm.mjs",
    "test": "node --test scripts/osm-turns.test.mjs",
    "make-icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@garmin/fitsdk": "^21.221.0",
    "@xmldom/xmldom": "^0.9.6",
    "sharp": "^0.35.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.20.5"
  }
}
